#include <winver.h>

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "Riley Fontaine"
      VALUE "FileDescription",  "Hi Box test application"
      VALUE "FileVersion",      "1.0.0.0"
      VALUE "InternalName",     "hi-box"
      VALUE "LegalCopyright",   "Copyright (C) 2026 Riley Fontaine"
      VALUE "OriginalFilename", "hi-box.exe"
      VALUE "ProductName",      "Hi Box"
      VALUE "ProductVersion",   "1.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

1 RT_MANIFEST "box.manifest"
